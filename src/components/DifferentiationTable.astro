---
// S4 A regua de diferenciacao. "ERP simula, agente opera." Degrau 4 e a bandeira.
const rows = [
  { n: '1', step: 'Tirar dúvida da reforma (chatbot)', who: 'Todos, de graça', pos: 'Não competimos aqui. Útil e genérico.', flag: false },
  { n: '2', step: 'Simular regime por cliente', who: 'Domínio e Alterdata, no ERP', pos: 'Não abrimos conversa por aqui.', flag: false },
  { n: '3', step: 'Simular a carteira inteira em massa, ranquear, white-label, multi-sistema', who: 'Só o Kontiva', pos: 'Todos os seus clientes de uma vez, em qualquer sistema, com a sua marca.', flag: false },
  { n: '4', step: 'Operar a rotina: créditos, adimplência de fornecedor, caixa do split e pricing, contínuo, com observabilidade e aprovação', who: 'Vazio. Nossa bandeira.', pos: 'A pergunta que ninguém responde: quem vai rodar isso todo mês para os seus clientes?', flag: true },
];
---
<section class="bg-dark" aria-labelledby="dif-h">
  <div class="shell">
    <div class="section-head reveal">
      <div class="eyebrow"><span class="dot-cyan"></span> A régua</div>
      <h2 id="dif-h">Onde a maioria para, o Kontiva começa.</h2>
      <p class="lead">Tirar dúvida e simular um cliente por vez já é grátis nos ERPs. Ótimo, use o do seu ERP. O nosso degrau é outro.</p>
    </div>

    <div class="ladder reveal delay-1">
      <div class="ladder-row head">
        <div>Degrau</div><div>Quem está lá</div><div>Como o Kontiva se posiciona</div>
      </div>
      {rows.map((r) => (
        <div class={`ladder-row ${r.flag ? 'flagged' : ''}`}>
          <div class="ladder-step"><span class="n">{r.n}</span>{r.step}</div>
          <div class="ladder-who">{r.who}</div>
          <div class="ladder-pos">
            {r.flag && <span class="ladder-flag">Nossa bandeira</span>}
            {r.pos}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
