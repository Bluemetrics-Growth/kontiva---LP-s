---
// Aba Fluxo de caixa da simulacao, com split payment ligado (Screenshot 19). Passo 04 (S5).
import AppFrame from './AppFrame.astro';
import Icon from '../Icon.astro';
import { showcase, avisoFaseTestes } from '../../data/showcase';

const meses = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
// alturas relativas do buraco de caixa projetado (pico em Ago/2027)
const alt = [28, 34, 41, 52, 60, 68, 82, 100, 86, 71, 58, 47];
const peakIdx = 7;
---
<AppFrame active="simulacoes" crumb={['Simulacoes', 'Construtora Horizonte', 'Fluxo de caixa']}>
  <div class="af-warn">
    <span class="tag">Recurso em fase de testes</span>
    <span class="msg">{avisoFaseTestes}</span>
  </div>

  <div class="af-prem">
    <span class="k">Premissas</span><span class="v">2027</span><span class="sep">·</span>
    <span class="v">SP</span><span class="sep">·</span><span class="k">Split</span><span class="v">Ligado</span>
  </div>

  <div class="af-tabs">
    <span class="af-tab">Resultado</span>
    <span class="af-tab">Lancamentos e notas</span>
    <span class="af-tab on">Fluxo de caixa</span>
  </div>

  <div class="af-cashcard">
    <div class="af-cashhead">
      <h4>Fluxo de caixa</h4>
      <span class="note">Entradas, saidas e saldo tributario mes a mes.</span>
    </div>
    <div class="af-check"><span class="box"><Icon name="check" size={11} /></span> Simular split payment do IBS/CBS em 2027</div>

    <div class="af-chart">
      {alt.map((h, i) => (
        <div class={`af-bar ${i === peakIdx ? 'peak' : ''}`}>
          {i === peakIdx && <span class="peaklbl">{showcase.buracoCaixaPico}</span>}
          <span class="fill" style={`height:${h}%`}></span>
          <span class="m">{meses[i]}</span>
        </div>
      ))}
    </div>
    <div class="af-chart-cap">
      <span class="k"><span class="sw" style="background:var(--ciano);"></span> Mes de pico do imposto na venda</span>
      <span class="k"><span class="sw" style="background:color-mix(in oklab, var(--azul-profundo) 20%, #cdd6e4);"></span> Saida projetada mensal</span>
    </div>
  </div>
  <p class="disclaimer">Projecao 2027 com base nos dados fornecidos. Nao substitui parecer profissional.</p>
</AppFrame>
