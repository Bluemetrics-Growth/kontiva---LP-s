---
// Prova visual da Dobra 2 (Agente de Honorarios): uma cobranca aberta com
// memoria de calculo. Reusa a linguagem visual do card de observabilidade
// (chat-mock "Resposta com memoria de calculo") do Passo 01. Puramente ilustrativo.
import Icon from '../Icon.astro';
import { seloExemplo } from '../../data/showcase';
---
<div class="chat-mock calc-card" aria-hidden="true">
  <div class="chat-head">
    <div class="t"><span class="k"><Icon name="radar" size={15} /></span> Cobrança com memória de cálculo</div>
    <span class="live">Observabilidade</span>
  </div>

  <div class="calc-body">
    <div class="calc-client">
      <span class="calc-avatar"><Icon name="users" size={15} /></span>
      <div class="calc-clienttx">
        <strong>Construtora Horizonte Ltda.</strong>
        <small>Excedente de serviço + reajuste</small>
      </div>
    </div>

    <div class="calc-rows">
      <div class="calc-row"><span class="calc-k">Limite contratado</span><span class="calc-v">12 serviços / mês</span></div>
      <div class="calc-row"><span class="calc-k">Volume observado</span><span class="calc-v">15 serviços</span></div>
      <div class="calc-row flag"><span class="calc-k">Excedente</span><span class="calc-v">3 serviços</span></div>
      <div class="calc-row"><span class="calc-k">Reajuste</span><span class="calc-v">índice do contrato no valor base</span></div>
    </div>

    <div class="calc-formula">
      <span class="calc-formula-lbl">Fórmula</span>
      <code>base + (excedente × valor unitário) + reajuste</code>
    </div>

    <div class="calc-total">
      <span class="calc-total-lbl">Valor a cobrar</span>
      <span class="calc-total-v">R$ 4.180</span>
    </div>

    <div class="calc-foot">
      <span class="calc-state"><span class="d"></span> Requer sua revisão</span>
      <span class="calc-approve"><Icon name="check" size={14} /> Aprovar</span>
    </div>

    <span class="calc-src">memória de cálculo · contrato + volume do mês</span>
  </div>

  <span class="calc-seal">{seloExemplo}</span>
</div>
