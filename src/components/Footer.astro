---
import { whatsappHref } from '../data/showcase';
const year = new Date().getFullYear();
---
<footer class="site">
  <div class="shell">
    <div class="foot-top">
      <div>
        <div class="brand-lockup"><span class="k">Kontiva</span><span class="dot">.</span><span class="ai">ai</span></div>
        <p class="foot-tag">O Hub de agentes de IA que opera os processos críticos do escritório contábil.</p>
      </div>
      <nav class="foot-links" aria-label="Contato e legal">
        <a href={whatsappHref} target="_blank" rel="noreferrer" data-cta="whatsapp">WhatsApp</a>
        <a href="mailto:contato@kontiva.ai">contato@kontiva.ai</a>
        <a href="/privacidade">Política de Privacidade</a>
        <a href="/termos">Termos de Uso</a>
      </nav>
    </div>
    <div class="foot-bottom">
      <span class="foot-seal"><b>Kontiva</b> é uma empresa BlueMetrics.</span>
      <span>&copy; {year} Kontiva. Todos os direitos reservados.</span>
    </div>
  </div>
</footer>
