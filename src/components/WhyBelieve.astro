---
// S8 Por que acreditar (as 5 provas).
const provas = [
  { t: 'Setup de Teste sem custo', d: 'A gente configura os agentes com você e roda numa amostra da sua carteira. Você vê o resultado em reais antes de assinar.' },
  { t: 'Observabilidade', d: 'Cada resposta e cada cálculo mostram a fonte e a memória de cálculo, com a alíquota vigente lida do sistema. O antídoto ao medo de IA que inventa.' },
  { t: 'Aprovação humana em tudo que executa', d: 'O contador manda, o agente prepara. Nada financeiro é emitido sem a sua revisão, e fica registrado quem aprovou o quê.' },
  { t: 'Multi-sistema', d: 'Lê Domínio, Alterdata, Questor e planilhas. Você não troca nada.' },
  { t: 'Engenharia BlueMetrics', d: '10+ anos de IA aplicada, 200+ projetos, AWS Advanced Partner. Agente de verdade, não script com LLM.' },
];
---
<section class="bg-calm" id="por-que-confiar" aria-labelledby="why-h">
  <div class="shell">
    <div class="section-head reveal">
      <div class="eyebrow"><span class="dot-cyan"></span> Por que acreditar</div>
      <h2 id="why-h">Cinco motivos para confiar antes de pagar.</h2>
    </div>
    <div class="believe-grid">
      {provas.map((p, i) => (
        <article class={`believe-card reveal delay-${(i % 4) + 1}`}>
          <div class="b-num">{String(i + 1).padStart(2, '0')}</div>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </article>
      ))}
    </div>
  </div>
</section>
